# Public URL of the app (used in emails, Stripe redirects, auth links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server only)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price id of the Solo plan ($24/month recurring)
STRIPE_PRICE_SOLO=

# Resend
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "JobTalk <invoices@yourdomain.com>"
EMAIL_FROM=
